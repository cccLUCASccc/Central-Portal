---
import '../../styles/global.css';

export const prerender = false;

const { id } = Astro.params;
const API_URL = import.meta.env.API_URL;

let current;

try {
    // 1. Essayer l'endpoint dédié d'inventaire (permet de charger l'objet même s'il est inactif)
    const inventoryUrl = `${API_URL}/front/antiquites/inventory/${id}`;
    const response = await fetch(inventoryUrl);
    if (response.ok) {
        current = await response.json();
    } else {
        // Fallbacks
        const fallbackUrl = `${API_URL}/front/antiquites?id=${id}`;
        const fbRes = await fetch(fallbackUrl);
        if (fbRes.ok) {
            const result = await fbRes.json();
            const data = Array.isArray(result) ? result : (result.data || []);
            current = data.find((item: any) => item.id == id);
        }
    }
} catch (error: any) {
    console.error(error.message);
}

const primaryImage = current?.images && current.images.length > 0 
    ? (current.images.find((img: any) => img.is_primary) || current.images[0])
    : null;
---

<!DOCTYPE html>
<html lang="fr" data-theme="corporate">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{current ? current.name : "Objet introuvable"} // Fiche Inventaire</title>
    <meta name="robots" content="noindex, nofollow">
    <!-- Google Fonts : Plus Jakarta Sans & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
</head>
<body class="bg-[#F6F4EE] text-black min-h-screen flex items-center justify-center p-4 font-mono">
    <div class="w-full max-w-md bg-white border-3 border-black shadow-[6px_6px_0px_0px_#000] overflow-hidden">
        <!-- Titlebar Rétro -->
        <div class="bg-[#FFC2D1] border-b-2 border-black p-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 bg-black"></span>
                <span class="font-black text-xs uppercase tracking-wider text-black">
                    DAISY GESTIONNAIRE.SYS // INVENTORY TAG
                </span>
            </div>
            <span class="retro-badge bg-black text-white text-[9px]">#{id}</span>
        </div>
        
        <div class="p-6 space-y-5">
            {current ? (
                <>
                <!-- Image principale de l'objet -->
                {primaryImage && (
                    <div class="relative aspect-square w-full overflow-hidden border-2 border-black bg-[#EDE9DF] shadow-[3px_3px_0px_0px_#000]">
                        <img 
                            src={primaryImage.url} 
                            alt={current.name} 
                            class="w-full h-full object-contain p-2"
                        />
                        <div class="absolute bottom-2 right-2">
                            <span class="retro-badge bg-black text-white text-[9px]">VISUEL PRINCIPAL</span>
                        </div>
                    </div>
                )}

                <div>
                    <span class="retro-badge bg-[#D4E2FD] text-[10px]">{current.category || "Antiquité"}</span>
                    <h2 class="text-xl font-black uppercase text-black mt-2 leading-tight">{current.name}</h2>
                    <span class="text-xs text-black/60 font-bold block mt-0.5">Époque : {current.year || "Non renseignée"}</span>
                </div>
                
                <div class="p-4 bg-[#FFD2A6] border-2 border-black shadow-[2px_2px_0px_0px_#000] flex items-center justify-between">
                    <span class="text-xs font-bold uppercase text-black">Prix de vente</span>
                    <span class="text-2xl font-black text-black">{current.price} €</span>
                </div>

                <div class="space-y-4 text-xs">
                    <div class="bg-[#F6F4EE] p-4 border-2 border-black space-y-2">
                        <span class="font-black uppercase tracking-wider text-black block">Description</span>
                        <p class="text-black/80 leading-relaxed whitespace-pre-line">
                            {current.description || "Aucune description détaillée."}
                        </p>
                    </div>

                    <div class="flex items-center justify-between p-3 border-2 border-black bg-white">
                        <span class="font-black uppercase text-black">Statut Boutique</span>
                        {current.status === 0 ? (
                            <span class="retro-badge bg-[#99E7DC] text-[10px] flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-700 inline-block"></span> En ligne</span>
                        ) : current.status === 2 ? (
                            <span class="retro-badge bg-[#FFC2D1] text-[10px] flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-red-600 inline-block"></span> Vendu</span>
                        ) : (
                            <span class="retro-badge bg-white text-[10px] flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-neutral-400 inline-block"></span> Inactif</span>
                        )}
                    </div>

                    {current.status === 0 && (
                        <div class="pt-2">
                            <a 
                                href={`https://daisybrocante.com/boutique/${current.name.replace(/\.+$/, '').trim()}`} 
                                target="_blank" 
                                rel="noopener noreferrer" 
                                class="retro-btn-primary w-full py-2.5 text-xs font-black shadow-[3px_3px_0px_0px_#000] flex items-center justify-center gap-1.5"
                            >
                                <span>Voir sur le site public</span>
                                <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                            </a>
                        </div>
                    )}
                </div>
                </>
            ) : (
                <div class="text-center py-10 space-y-3">
                    <div class="flex justify-center"><span class="material-symbols-outlined text-4xl text-black/40">search</span></div>
                    <h2 class="text-base font-black uppercase text-black">Objet introuvable</h2>
                    <p class="text-xs text-black/60">Impossible de charger cet objet ou référence introuvable.</p>
                </div>
            )}
        </div>
    </div>
</body>
</html>
