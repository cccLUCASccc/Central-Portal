---
import BasicLayout from '../../layouts/basic.astro';
import AntiquiteCreator from '../../components/SveltesComponents/molecules/antiquiteCreator.svelte';
---

<BasicLayout>
    <div class="max-w-4xl mx-auto space-y-4 font-mono">
        <div class="flex items-center justify-between">
            <a href="/antiquites" class="retro-btn py-1.5 px-3 text-xs bg-white hover:bg-[#FFE600]">
                « Retour à l'inventaire
            </a>
            <div class="text-xs text-black/60 font-bold uppercase">
                <span>Inventaire</span> / <span>Création</span>
            </div>
        </div>

        <AntiquiteCreator client:load/>
    </div>
</BasicLayout>