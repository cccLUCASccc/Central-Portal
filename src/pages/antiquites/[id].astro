---
import BasicLayout from '../../layouts/basic.astro';
import AntiquitesModifier from '../../components/SveltesComponents/molecules/antiquitesModifier.svelte';

export const prerender = false;
const auth = Astro.locals.auth();
const token  = await auth.getToken();
const userId = auth.userId;

const { id } = Astro.params;
const API_URL = import.meta.env.API_URL;
const finalUrl = `${API_URL}/api/antiquites/single/${id}`;

let current;

if (userId) {
    try {
        const response = await fetch(finalUrl, {
            headers : {
                'Authorization' : `Bearer ${token}`
            }
        });

        if (!response.ok) {
            return Astro.redirect('/'); 
        }

        current = await response.json();
    } catch(error : any) {
        console.error(error.message);
    }
}
---

<BasicLayout>
    <div class="max-w-4xl mx-auto space-y-4 font-mono">
        <div class="flex items-center justify-between">
            <a href="/" class="retro-btn py-1.5 px-3 text-xs bg-white hover:bg-[#FFE600]">
                « Retour à l'inventaire
            </a>
            <div class="text-xs text-black/60 font-bold uppercase">
                <span>Inventaire</span> / <span>Édition #{id}</span>
            </div>
        </div>

        {current && (
            <AntiquitesModifier client:load antiquite={current} />
        )}
    </div>
</BasicLayout>