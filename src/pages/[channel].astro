---
import BasicLayout from '../layouts/basic.astro';
import { Show } from '@clerk/astro/components';
import ChannelConnection from '../components/SveltesComponents/atoms/ChannelConnection.svelte';
import SocialPublicationComposer from '../components/SveltesComponents/molecules/SocialPublicationComposer.svelte';
import { channels } from '../lib/channels';

const channel = channels.find((item) => item.id === Astro.params.channel && item.id !== 'ebay');
if (!channel) {
  return new Response('Page introuvable', { status: 404 });
}
const userId = Astro.locals.auth().userId;
---

<BasicLayout>
  <Show when="signed-in">
    <section class="space-y-6 font-mono" aria-labelledby="channel-title">
      <a href="/canaux-vente" class="text-xs font-bold underline">Canaux de vente</a>
      <header class="border-b-2 border-black pb-6">
        <h1 id="channel-title" class="text-3xl font-black uppercase">{channel.name}</h1>
        <p class="mt-2 text-sm text-black/65">{channel.description}</p>
      </header>
      <ChannelConnection channel={channel.id} apiUrl={import.meta.env.API_URL || import.meta.env.PUBLIC_API_URL} client:load />
      <a href={channel.profileUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-bold underline">
        Ouvrir {channel.name} <span class="material-symbols-outlined text-base" aria-hidden="true">open_in_new</span>
        <span class="sr-only">(nouvel onglet)</span>
      </a>
      {userId && (channel.id === 'facebook' || channel.id === 'instagram' || channel.id === 'tiktok') && (
        <SocialPublicationComposer
          channel={channel.id}
          apiUrl={import.meta.env.API_URL || import.meta.env.PUBLIC_API_URL}
          userId={userId}
          client:load
        />
      )}
    </section>
  </Show>
</BasicLayout>
