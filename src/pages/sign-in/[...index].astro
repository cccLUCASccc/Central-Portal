---
import "../../styles/global.css";
import RetroAuthTerminal from "../../components/SveltesComponents/molecules/RetroAuthTerminal.svelte";

const auth = Astro.locals.auth();
const userId = auth.userId;

// Si l'utilisateur est déjà connecté, redirection vers l'accueil
if (userId) {
  return Astro.redirect("/");
}
---

<!doctype html>
<html lang="fr" data-theme="corporate">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Connexion // Gestionnaire Daisy Brocante</title>
  </head>

  <body class="min-h-screen bg-[#F6F4EE] text-black font-sans flex flex-col antialiased selection:bg-[#FFC2D1] selection:text-black">
    <!-- Retro Top Banner -->
    <div class="w-full bg-[#FFC2D1] border-b-2 border-black py-1.5 px-4 text-xs font-black uppercase tracking-wider text-black flex items-center justify-between overflow-x-auto whitespace-nowrap z-50">
      <div class="flex items-center gap-3">
        <span class="inline-block w-2 h-2 bg-black rounded-none animate-pulse"></span>
        <span>⚡ DAISY BROCANTE // GESTIONNAIRE.SYS — AUTHENTIFICATION</span>
      </div>
      <div class="hidden md:flex items-center gap-4 text-[11px] font-mono">
        <span class="border border-black px-1.5 py-0.5 bg-white shadow-[1px_1px_0px_0px_#000]">SERVEUR: EN LIGNE</span>
        <span class="border border-black px-1.5 py-0.5 bg-[#99E7DC] shadow-[1px_1px_0px_0px_#000]">ACCÈS SÉCURISÉ</span>
      </div>
    </div>

    <!-- Main Container -->
    <main class="flex-grow flex items-center justify-center p-4 sm:p-6 lg:p-8 bg-[#F6F4EE] relative">
      <div class="w-full max-w-md mx-auto">
        <RetroAuthTerminal client:load targetUrl="/" />
      </div>
    </main>

    <!-- Retro Footer -->
    <footer class="bg-[#EDE9DF] border-t-2 border-black py-3 px-6 text-black font-mono text-xs flex flex-col sm:flex-row items-center justify-between gap-2 shadow-[0_-2px_0px_0px_#000]">
      <div class="flex items-center gap-3">
        <span class="retro-badge bg-[#99E7DC]">SYS_OK</span>
        <span class="text-black/70">Gestionnaire.SYS Terminal © 2026</span>
      </div>
      <div class="flex items-center gap-4 text-black/60 text-[11px]">
        <span>ENV: PRODUCTION</span>
        <span>DAISY BROCANTE</span>
      </div>
    </footer>
  </body>
</html>
