---
import BasicLayout from '../layouts/basic.astro';
import MartyManager from '../components/SveltesComponents/molecules/MartyManager.svelte';
import { Show } from '@clerk/astro/components';

const auth = Astro.locals.auth();
const userId = auth.userId;
const defaultScrapperUrl = import.meta.env.SCRAPPER_URL;
---

<BasicLayout>
    <Show when="signed-in">
        <MartyManager client:load defaultScrapperUrl={defaultScrapperUrl} />
    </Show>
</BasicLayout>

