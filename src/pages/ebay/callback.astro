---
import BasicLayout from '../../layouts/basic.astro';
import { Show } from '@clerk/astro/components';
import ChannelConnection from '../../components/SveltesComponents/atoms/ChannelConnection.svelte';
---

<BasicLayout>
  <Show when="signed-in">
    <section class="space-y-6 font-mono">
      <h1 class="text-3xl font-black uppercase">Connexion eBay</h1>
      <ChannelConnection channel="ebay" apiUrl={import.meta.env.API_URL || import.meta.env.PUBLIC_API_URL} client:load />
      <a href="/ebay" class="text-xs font-bold underline">Retour aux annonces eBay</a>
    </section>
  </Show>
</BasicLayout>
