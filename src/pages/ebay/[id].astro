---
import BasicLayout from '../../layouts/basic.astro';
import EbayModifier from '../../components/SveltesComponents/molecules/EbayModifier.svelte';

export const prerender = false;
const auth = Astro.locals.auth();
const token = await auth.getToken();
const userId = auth.userId;

const { id } = Astro.params;
const API_URL = import.meta.env.API_URL;
const finalUrl = `${API_URL}/api/antiquites/single/${id}`;

let current = null;

if (userId) {
    try {
        const response = await fetch(finalUrl, {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });

        if (!response.ok) {
            return Astro.redirect('/ebay'); 
        }

        current = await response.json();
    }
    catch (error: any) {
        console.error("🔥 [eBay Detail] Erreur fetch :", error.message);
    }
}
---

<BasicLayout>
    <div class="max-w-5xl mx-auto">
        <div class="mb-8 flex items-center justify-between">
            <a href="/ebay" onclick="history.back(); return false;" class="btn btn-ghost btn-sm gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
                Retour aux annonces eBay
            </a>
            <div class="text-sm breadcrumbs opacity-50">
                <ul>
                    <li><a href="/">Accueil</a></li>
                    <li><a href="/ebay">eBay</a></li>
                    <li>Annonce {id}</li>
                </ul>
            </div>
        </div>

        {current ? (
            <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
                <div class="bg-info/5 p-6 border-b border-base-200 flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl font-bold flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                            </svg>
                            Annonce eBay
                        </h1>
                        <p class="text-sm opacity-60">Personnalisez les détails spécifiquement pour eBay, indépendamment du site.</p>
                    </div>
                    <div class="badge badge-info badge-outline font-semibold font-mono">{current.name}</div>
                </div>
                <div class="p-6 md:p-10">
                    <EbayModifier client:load antiquite={current} />
                </div>
            </div>
        ) : (
            <div class="alert alert-error">
                <span>Erreur : Impossible de charger les détails de l'antiquité.</span>
            </div>
        )}
    </div>
</BasicLayout>
