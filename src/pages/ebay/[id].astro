---
import BasicLayout from '../../layouts/basic.astro';
import EbayModifier from '../../components/SveltesComponents/molecules/EbayModifier.svelte';

export const prerender = false;
const auth = Astro.locals.auth();
const token = await auth.getToken();
const userId = auth.userId;

const { id } = Astro.params;
const API_URL = import.meta.env.API_URL;
const finalUrl = `${API_URL}/api/antiquites/single/${id}`;

let current = null;

if (userId) {
    try {
        const response = await fetch(finalUrl, {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });

        if (!response.ok) {
            return Astro.redirect('/ebay'); 
        }

        current = await response.json();
    }
    catch (error: any) {
        console.error("🔥 [eBay Detail] Erreur fetch :", error.message);
    }
}
---

<BasicLayout>
    <div class="max-w-5xl mx-auto">
        <div class="mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-2">
                <a href="/ebay" onclick="history.back(); return false;" class="btn btn-ghost btn-sm gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
                    Retour aux annonces eBay
                </a>
            </div>

            <!-- Navigation Flèches Objet Précédent / Suivant -->
            <div class="flex items-center gap-2" id="nav-arrows-container" data-prev-id={current?.prev_id} data-next-id={current?.next_id}>
                {current?.prev_id ? (
                    <a href={`/ebay/${current.prev_id}`} id="btn-prev-item" class="btn btn-outline btn-info btn-sm gap-1 text-xs" title="Annonce précédente (Flèche Gauche ←)">
                        ‹ Précédente #{current.prev_id}
                    </a>
                ) : (
                    <button class="btn btn-outline btn-sm gap-1 text-xs btn-disabled opacity-40">
                        ‹ Précédente
                    </button>
                )}

                {current?.next_id ? (
                    <a href={`/ebay/${current.next_id}`} id="btn-next-item" class="btn btn-outline btn-info btn-sm gap-1 text-xs" title="Annonce suivante (Flèche Droite →)">
                        Suivante #{current.next_id} ›
                    </a>
                ) : (
                    <button class="btn btn-outline btn-sm gap-1 text-xs btn-disabled opacity-40">
                        Suivante ›
                    </button>
                )}
            </div>

            <div class="text-sm breadcrumbs opacity-50 hidden md:block">
                <ul>
                    <li><a href="/">Accueil</a></li>
                    <li><a href="/ebay">eBay</a></li>
                    <li>Annonce {id}</li>
                </ul>
            </div>
        </div>

        {current ? (
            <div class="card bg-base-100 shadow-xl border border-base-200 overflow-hidden">
                <div class="bg-info/5 p-6 border-b border-base-200 flex justify-between items-center">
                    <div>
                        <h1 class="text-2xl font-bold flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                            </svg>
                            Annonce eBay
                        </h1>
                        <p class="text-sm opacity-60">Personnalisez les détails spécifiquement pour eBay, indépendamment du site.</p>
                    </div>
                    <div class="badge badge-info badge-outline font-semibold font-mono">{current.name}</div>
                </div>
                <div class="p-6 md:p-10">
                    <EbayModifier client:load antiquite={current} />
                </div>
            </div>
        ) : (
            <div class="alert alert-error">
                <span>Erreur : Impossible de charger les détails de l'antiquité.</span>
            </div>
        )}
    </div>
</BasicLayout>

<script>
    function initKeyboardNav() {
        const container = document.getElementById('nav-arrows-container');
        if (!container) return;

        const prevId = container.dataset.prevId;
        const nextId = container.dataset.nextId;

        const handleKeyDown = (e: KeyboardEvent) => {
            const activeElement = document.activeElement;
            if (activeElement) {
                const tagName = activeElement.tagName.toLowerCase();
                const isContentEditable = activeElement.getAttribute('contenteditable') === 'true';
                if (tagName === 'input' || tagName === 'textarea' || tagName === 'select' || isContentEditable) {
                    return;
                }
            }

            if (e.key === 'ArrowLeft' && prevId) {
                window.location.href = `/ebay/${prevId}`;
            } else if (e.key === 'ArrowRight' && nextId) {
                window.location.href = `/ebay/${nextId}`;
            }
        };

        document.addEventListener('keydown', handleKeyDown);
        return () => document.removeEventListener('keydown', handleKeyDown);
    }

    let cleanup = initKeyboardNav();
    document.addEventListener('astro:after-swap', () => {
        if (cleanup) cleanup();
        cleanup = initKeyboardNav();
    });
</script>
