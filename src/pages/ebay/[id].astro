---
import BasicLayout from '../../layouts/basic.astro';
import EbayModifier from '../../components/SveltesComponents/molecules/EbayModifier.svelte';

export const prerender = false;
const auth = Astro.locals.auth();
const token = await auth.getToken();
const userId = auth.userId;

const { id } = Astro.params;
const API_URL = import.meta.env.API_URL;
const finalUrl = `${API_URL}/api/antiquites/single/${id}`;

let current = null;

if (userId) {
    try {
        const response = await fetch(finalUrl, {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });

        if (!response.ok) {
            return Astro.redirect('/ebay'); 
        }

        current = await response.json();
    }
    catch (error: any) {
        console.error("🔥 [eBay Detail] Erreur fetch :", error.message);
    }
}
---

<BasicLayout>
    <div class="max-w-5xl mx-auto space-y-4 font-mono">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-2">
                <a href="/ebay" onclick="history.back(); return false;" class="retro-btn py-1.5 px-3 text-xs bg-white hover:bg-[#FFE600]">
                    « Retour aux annonces eBay
                </a>
            </div>

            <!-- Navigation Flèches Objet Précédent / Suivant -->
            <div class="flex items-center gap-1" id="nav-arrows-container" data-prev-id={current?.prev_id} data-next-id={current?.next_id}>
                {current?.prev_id ? (
                    <a href={`/ebay/${current.prev_id}`} id="btn-prev-item" class="retro-btn text-xs py-1 px-2.5 bg-white hover:bg-[#D4E2FD]" title="Annonce précédente (Flèche Gauche ←)">
                        « #{current.prev_id}
                    </a>
                ) : (
                    <button class="retro-btn text-xs py-1 px-2.5 bg-[#EDE9DF] opacity-40 cursor-not-allowed" disabled>
                        « Précédente
                    </button>
                )}

                {current?.next_id ? (
                    <a href={`/ebay/${current.next_id}`} id="btn-next-item" class="retro-btn text-xs py-1 px-2.5 bg-white hover:bg-[#D4E2FD]" title="Annonce suivante (Flèche Droite →)">
                        #{current.next_id} »
                    </a>
                ) : (
                    <button class="retro-btn text-xs py-1 px-2.5 bg-[#EDE9DF] opacity-40 cursor-not-allowed" disabled>
                        Suivante »
                    </button>
                )}
            </div>
        </div>

        {current ? (
            <EbayModifier client:load antiquite={current} />
        ) : (
            <div class="retro-card p-8 text-center text-xs text-black/70">
                <span>Erreur : Impossible de charger les détails de l'antiquité.</span>
            </div>
        )}
    </div>
</BasicLayout>

<script>
    function initKeyboardNav() {
        const container = document.getElementById('nav-arrows-container');
        if (!container) return;

        const prevId = container.dataset.prevId;
        const nextId = container.dataset.nextId;

        const handleKeyDown = (e: KeyboardEvent) => {
            const activeElement = document.activeElement;
            if (activeElement) {
                const tagName = activeElement.tagName.toLowerCase();
                const isContentEditable = activeElement.getAttribute('contenteditable') === 'true';
                if (tagName === 'input' || tagName === 'textarea' || tagName === 'select' || isContentEditable) {
                    return;
                }
            }

            if (e.key === 'ArrowLeft' && prevId) {
                window.location.href = `/ebay/${prevId}`;
            } else if (e.key === 'ArrowRight' && nextId) {
                window.location.href = `/ebay/${nextId}`;
            }
        };

        document.addEventListener('keydown', handleKeyDown);
        return () => document.removeEventListener('keydown', handleKeyDown);
    }

    let cleanup = initKeyboardNav();
    document.addEventListener('astro:after-swap', () => {
        if (cleanup) cleanup();
        cleanup = initKeyboardNav();
    });
</script>
