---
import "../styles/global.css";
import { Show, UserButton } from "@clerk/astro/components";
import TerminalBoot from "../components/SveltesComponents/atoms/TerminalBoot.svelte";

const auth = Astro.locals.auth();
const token = await auth.getToken();
const userId = auth.userId;

const pathname = Astro.url.pathname;
const isDaisyBrocante = pathname.startsWith('/antiquites') || 
                        pathname.startsWith('/subcategories') || 
                        pathname.startsWith('/ebay') || 
                        pathname.startsWith('/Livraison');
const isMarty = pathname.startsWith('/marty');
---

<!doctype html>
<html lang="fr" data-theme="corporate">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{isMarty ? "Marty // Scrapper Leads" : "Gestionnaire // Daisy Brocante"}</title>
  </head>

  <body class="min-h-screen bg-[#F6F4EE] text-black font-sans flex flex-col antialiased selection:bg-[#FFAEC1] selection:text-black">
    <Show when="signed-in">
      <TerminalBoot client:load initialActive={false} />
    </Show>

    <div class="drawer">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex flex-col min-h-screen">
        
        <Show when="signed-in">
          <!-- Retro Top Rose Ticker / Announcement Banner -->
          <div class="w-full bg-[#FFAEC1] border-b-2 border-black py-1.5 px-4 text-xs font-black uppercase tracking-wider text-black flex items-center justify-between overflow-x-auto whitespace-nowrap z-50">
            <div class="flex items-center gap-3">
              <span class="inline-block w-2 h-2 bg-black rounded-none animate-pulse"></span>
              {pathname === '/' ? (
                <span>⚡ PORTAIL CENTRAL // GESTIONNAIRE.SYS — HUB MULTI-PROJETS</span>
              ) : isDaisyBrocante ? (
                <span>⚡ DAISY BROCANTE // GESTIONNAIRE.SYS — STATION ACTIVE</span>
              ) : isMarty ? (
                <span>⚡ MARTY // GESTIONNAIRE.SYS — STATION PROSPECTION & LEADS</span>
              ) : (
                <span>⚡ PORTAIL CENTRAL // GESTIONNAIRE.SYS — SERVICE GLOBAL</span>
              )}
            </div>
            <div class="hidden md:flex items-center gap-4 text-[11px] font-mono">
              <button 
                type="button" 
                onclick="window.replayBoot && window.replayBoot()"
                class="border border-black px-1.5 py-0.5 bg-white shadow-[1px_1px_0px_0px_#000] hover:bg-[#FFF394] cursor-pointer flex items-center gap-1.5 transition-colors"
                title="Rejouer la séquence de boot du terminal"
              >
                <span>🖥️</span> SERVEUR: EN LIGNE
              </button>
              <span class="border border-black px-1.5 py-0.5 bg-[#86E2D5] shadow-[1px_1px_0px_0px_#000]">STORAGE: AWS S3</span>
            </div>
          </div>

          <!-- Retro Navbar -->
          <header class="bg-[#EDE9DF] border-b-2 border-black sticky top-0 z-40 px-4 py-2 flex items-center justify-between shadow-[0_2px_0px_0px_#000]">
            <div class="flex items-center gap-3">
              <!-- Mobile menu toggle button -->
              <label for="my-drawer" aria-label="open sidebar" class="retro-btn btn-sm lg:hidden px-2.5 bg-white">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 stroke-current stroke-2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
              </label>

              <!-- Logo & System Badge -->
              <a href="/" class="flex items-center gap-2.5 group flex-shrink-0" title="Retour au Hub des Projets">
                <div class="w-8 h-8 bg-[#FFD2A6] border-2 border-black flex items-center justify-center font-mono font-black text-base shadow-[2px_2px_0px_0px_#000] group-hover:bg-[#86E2D5] transition-colors">
                  {isMarty ? 'M' : 'G'}
                </div>
                <div class="flex flex-col">
                  <span class="font-black text-lg tracking-tight uppercase leading-none font-mono">GESTIONNAIRE<span class="text-[#FFAEC1]">.SYS</span></span>
                  <span class="text-[9px] font-mono font-bold tracking-widest text-black/60 uppercase">
                    {isDaisyBrocante ? "Daisy Brocante" : isMarty ? "Marty // Lead Scrapper" : "Portail Multi-Projets"}
                  </span>
                </div>
              </a>
            </div>

            <!-- Desktop Nav Buttons -->
            <nav class="hidden lg:flex items-center gap-1.5 font-mono flex-shrink-0">
              <!-- Bouton Cross-Projet : Hub Projets -->
              <a href="/" class="retro-btn py-1.5 px-3 text-xs bg-white whitespace-nowrap hover:bg-[#BFD7FE] {pathname === '/' ? '!bg-[#BFD7FE] shadow-[3px_3px_0px_0px_#000] -translate-x-0.5 -translate-y-0.5' : ''}">
                🗂️ Hub Projets
              </a>

              {isDaisyBrocante && (
                <>
                  <div class="h-5 w-px bg-black/30 mx-0.5"></div>

                  <!-- Boutons Spécifiques Daisy Brocante -->
                  <a href="/antiquites" class="retro-btn py-1.5 px-3 text-xs bg-white whitespace-nowrap hover:bg-[#FFF394] {pathname.startsWith('/antiquites') ? '!bg-[#FFF394] shadow-[3px_3px_0px_0px_#000] -translate-x-0.5 -translate-y-0.5' : ''}">
                    📋 Inventaire
                  </a>
                  <a href="/subcategories" class="retro-btn py-1.5 px-3 text-xs bg-white whitespace-nowrap hover:bg-[#FFD2A6] {pathname.startsWith('/subcategories') ? '!bg-[#FFD2A6] shadow-[3px_3px_0px_0px_#000] -translate-x-0.5 -translate-y-0.5' : ''}">
                    🏷️ Sous-catégories
                  </a>
                  <a href="/shops" class="retro-btn py-1.5 px-3 text-xs bg-white whitespace-nowrap hover:bg-[#86E2D5] {pathname.startsWith('/shops') ? '!bg-[#86E2D5] shadow-[3px_3px_0px_0px_#000] -translate-x-0.5 -translate-y-0.5' : ''}">
                    🏬 Boutiques
                  </a>
                  <a href="/ebay" class="retro-btn py-1.5 px-3 text-xs bg-white whitespace-nowrap hover:bg-[#FFF394] {pathname.startsWith('/ebay') ? '!bg-[#FFF394] shadow-[3px_3px_0px_0px_#000] -translate-x-0.5 -translate-y-0.5' : ''}">
                    📦 eBay
                  </a>
                  <a href="/Livraison" class="retro-btn py-1.5 px-3 text-xs bg-white whitespace-nowrap hover:bg-[#FFAEC1] {pathname.startsWith('/Livraison') ? '!bg-[#FFAEC1] shadow-[3px_3px_0px_0px_#000] -translate-x-0.5 -translate-y-0.5' : ''}">
                    🚚 Livraisons
                  </a>
                </>
              )}

              {isMarty && (
                <>
                  <div class="h-5 w-px bg-black/30 mx-0.5"></div>

                  <!-- Boutons Spécifiques Marty -->
                  <a href="/marty" class="retro-btn py-1.5 px-3 text-xs bg-white whitespace-nowrap hover:bg-[#FFD166] {pathname.startsWith('/marty') ? '!bg-[#FFD166] shadow-[3px_3px_0px_0px_#000] -translate-x-0.5 -translate-y-0.5 font-black' : ''}">
                    ⚡ Scrapper & Leads
                  </a>
                </>
              )}

              <div class="h-5 w-px bg-black/30 mx-0.5"></div>

              <!-- Bouton Cross-Projet : Fichiers S3 -->
              <a href="/storage" class="retro-btn py-1.5 px-3 text-xs bg-white whitespace-nowrap hover:bg-[#86E2D5] {pathname.startsWith('/storage') ? '!bg-[#86E2D5] shadow-[3px_3px_0px_0px_#000] -translate-x-0.5 -translate-y-0.5' : ''}">
                📁 Fichiers S3
              </a>
            </nav>


            <!-- Actions Right (Clerk UserButton) -->
            <div class="flex items-center gap-2">
              <div class="border-2 border-black p-0.5 bg-white shadow-[2px_2px_0px_0px_#000]">
                <UserButton />
              </div>
            </div>
          </header>
        </Show>

        <!-- Main Content Area -->
        <main class="flex-grow flex flex-col relative bg-[#F6F4EE]">
          <Show when="signed-in">
            <div class="p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto">
              <slot />
            </div>
          </Show>
        </main>

        <!-- Retro OS Status Footer -->
        <footer class="bg-[#EDE9DF] border-t-2 border-black py-3 px-6 text-black font-mono text-xs flex flex-col sm:flex-row items-center justify-between gap-2 shadow-[0_-2px_0px_0px_#000]">
          <div class="flex items-center gap-3">
            <button 
              type="button" 
              onclick="window.replayBoot && window.replayBoot()"
              class="retro-badge bg-[#86E2D5] hover:bg-[#65C4B5] cursor-pointer transition-transform active:scale-95"
              title="Cliquer pour relancer le terminal de démarrage"
            >
              ⚡ SYS_OK
            </button>
            <span class="text-black/70">Gestionnaire.SYS Terminal © 2026</span>
          </div>
          <div class="flex items-center gap-4 text-black/60 text-[11px]">
            <span>ENV: PRODUCTION</span>
            <span>PORTAIL CENTRAL</span>
          </div>
        </footer>
      </div>

      <!-- Mobile Retro Drawer -->
      <div class="drawer-side z-[100]">
        <label for="my-drawer" aria-label="close sidebar" class="drawer-overlay bg-black/60"></label>
        <div class="w-72 min-h-full bg-[#EDE9DF] border-r-2 border-black p-6 flex flex-col justify-between text-black font-mono">
          <div>
            <div class="p-3 bg-[#FFAEC1] border-2 border-black shadow-[3px_3px_0px_0px_#000] mb-6 flex items-center justify-between">
              <span class="font-black font-mono text-sm uppercase">Menu Gestionnaire</span>
              <label for="my-drawer" class="cursor-pointer font-bold px-1.5 border border-black bg-white">✕</label>
            </div>

            <nav class="flex flex-col gap-2.5">
              <!-- Cross-projet -->
              <a href="/" class="retro-btn justify-start text-xs bg-white hover:bg-[#BFD7FE] {pathname === '/' ? '!bg-[#BFD7FE]' : ''}">
                🗂️ Hub des Projets
              </a>

              {isDaisyBrocante && (
                <>
                  <div class="text-[10px] font-black uppercase text-black/60 px-1 pt-2 flex items-center gap-1.5">
                    <span>🌼</span> Projet Daisy Brocante
                  </div>

                  <a href="/antiquites" class="retro-btn justify-start text-xs bg-white hover:bg-[#FFF394] {pathname.startsWith('/antiquites') ? '!bg-[#FFF394]' : ''}">
                    📋 Inventaire
                  </a>
                  <a href="/subcategories" class="retro-btn justify-start text-xs bg-white hover:bg-[#FFD2A6] {pathname.startsWith('/subcategories') ? '!bg-[#FFD2A6]' : ''}">
                    🏷️ Sous-catégories
                  </a>
                  <a href="/shops" class="retro-btn justify-start text-xs bg-white hover:bg-[#86E2D5] {pathname.startsWith('/shops') ? '!bg-[#86E2D5]' : ''}">
                    🏬 Boutiques
                  </a>
                  <a href="/ebay" class="retro-btn justify-start text-xs bg-white hover:bg-[#FFF394] {pathname.startsWith('/ebay') ? '!bg-[#FFF394]' : ''}">
                    📦 eBay (Annonces)
                  </a>
                  <a href="/Livraison" class="retro-btn justify-start text-xs bg-white hover:bg-[#FFAEC1] {pathname.startsWith('/Livraison') ? '!bg-[#FFAEC1]' : ''}">
                    🚚 Livraisons
                  </a>
                </>
              )}

              {isMarty && (
                <>
                  <div class="text-[10px] font-black uppercase text-black/60 px-1 pt-2 flex items-center gap-1.5">
                    <span>🕵️</span> Projet Marty (Lead Gen)
                  </div>

                  <a href="/marty" class="retro-btn justify-start text-xs bg-white hover:bg-[#FFD166] {pathname.startsWith('/marty') ? '!bg-[#FFD166] font-black' : ''}">
                    ⚡ Scrapper & Leads
                  </a>
                </>
              )}

              <div class="text-[10px] font-black uppercase text-black/60 px-1 pt-2">Services Globaux</div>

              <a href="/storage" class="retro-btn justify-start text-xs bg-white hover:bg-[#86E2D5] {pathname.startsWith('/storage') ? '!bg-[#86E2D5]' : ''}">
                📁 Fichiers S3
              </a>
            </nav>
          </div>

          <div class="p-3 bg-white border-2 border-black text-[10px] text-black/70 shadow-[2px_2px_0px_0px_#000]">
            <p class="font-bold uppercase text-black mb-1">Station Gestionnaire.SYS</p>
            <p>Portail Multi-Projets Central</p>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
